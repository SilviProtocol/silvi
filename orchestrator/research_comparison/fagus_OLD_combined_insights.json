[{"id":"1ca83d2e-dc8b-4a14-8c17-e9a502723768","taxon_id":"AngMaFaFgCx14888-00","claim_type":"agroforestry_use_cases","claim_value":{"text": "Traditional use in wood pasture (silvopasture) systems since Roman times. Pigs released to feed on acorns (pannage). Coppice management for sustainable timber. Pollarding for wood products. Hedgerow trees for shade and windbreaks. Modern alley cropping potential for timber/pasture integration.", "systems": ["Silvopasture/wood pasture", "Coppice", "Pollarding", "Hedgerow", "Alley cropping"], "products": ["Timber", "Fodder (acorns for pigs)", "Firewood", "Charcoal", "Tanbark"], "historical_practices": ["Pannage (pig foraging)", "Wattle production", "Charcoal making"]},"confidence":0.89,"sources":[{"url": "https://link.springer.com/article/10.1007/s10457-021-00718-3", "type": "paper", "title": "Oak agroforestry systems review", "credibility": 0.93, "accessed_date": "2026-01-06"}, {"url": "https://www.coppiceagroforestry.com/blog/european-wood-pasture-silvopasture-case-studies", "type": "website", "title": "Coppice Agroforestry", "credibility": 0.8, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"b3eff63a-4be2-4520-b306-9bf5048bf25c","taxon_id":"AngMaFaFgCx14888-00","claim_type":"associated_species","claim_value":{"text": "Forms mixed forests with Fagus sylvatica (beech), Fraxinus excelsior (ash), Carpinus betulus (hornbeam), Tilia species (lime), Acer species (maple), Ulmus species (elm). Understory includes Corylus avellana (hazel), Crataegus (hawthorn), Ilex aquifolium (holly). Eurasian jays are primary seed dispersers.", "key_fauna": ["Garrulus glandarius (jay)", "Sciurus species (squirrels)", "Sus scrofa (wild boar)"], "tree_associates": ["Fagus sylvatica", "Fraxinus excelsior", "Carpinus betulus", "Tilia cordata", "Acer campestre", "Ulmus glabra"], "shrub_associates": ["Corylus avellana", "Crataegus monogyna", "Ilex aquifolium", "Prunus spinosa"]},"confidence":0.84,"sources":[{"url": "https://www.euforgen.org/species/quercus-robur", "type": "database", "title": "EUFORGEN", "credibility": 0.92, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"3c51320d-0896-460d-8096-36c0cc82eaaf","taxon_id":"AngMaFaFgCx14888-00","claim_type":"bark_characteristics","claim_value":{"text": "Young trees have smooth gray-green bark. Mature trees develop deeply fissured bark with vertical ridges, gray-brown in color. Texture becomes increasingly rugged and corky with age. Fissures deepen significantly in old trees.", "texture": "Rugged, corky with age", "young_bark": "Smooth, gray-green", "mature_bark": "Deeply fissured, gray-brown, vertical ridges"},"confidence":0.83,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"099cd8ca-52e1-4152-ad09-766bef4ba6ee","taxon_id":"AngMaFaFgCx14888-00","claim_type":"climate_tolerance","claim_value":{"text": "Temperate climate species. Favors bright sunlight (light-demanding), moderate temperature, and adequate moisture. Ellenberg values: L=7 (light), T=6 (temperature), F=6 (moisture), R=5 (pH), N=2-6 (nutrients), S=0 (salinity). USDA Hardiness zones 5-8. Tolerates winter temperatures to -25C.", "hardiness_zones": {"USDA": "5-8"}, "light_requirement": "Full sun to partial shade", "temperature_range": {"min": -25, "unit": "celsius"}},"confidence":0.89,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}, {"url": "https://plants.ces.ncsu.edu/plants/quercus-robur/", "type": "database", "title": "NC State Extension", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"3f9df219-cefc-4c6a-a1a9-bb9e44bf50a0","taxon_id":"AngMaFaFgCx14888-00","claim_type":"compatible_soil_types","claim_value":{"text": "Prefers deep, fertile, well-watered loam soils. Thrives on medium (loamy) and heavy (clay) soils including heavy clay. Tolerates a range of pH from mildly acid to mildly alkaline. Lime tolerant. Grows well on calcareous to moderately acid soils. Avoids thin, dry, shallow soils and very poor sandy soils.", "avoided": ["Thin soils", "Very sandy", "Shallow chalky", "Acidic peat"], "preferred": ["Deep loam", "Clay-loam", "Heavy clay", "Fertile alluvial"], "tolerated": ["Mildly acidic", "Neutral", "Mildly alkaline"]},"confidence":0.88,"sources":[{"url": "https://pfaf.org/user/Plant.aspx?LatinName=Quercus+robur", "type": "database", "title": "PFAF Database", "credibility": 0.88, "accessed_date": "2026-01-06"}, {"url": "https://www.gardenia.net/plant/quercus-robur", "type": "website", "title": "Gardenia.net", "credibility": 0.82, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"40dfb93e-4353-4984-84b2-85e00783eecc","taxon_id":"AngMaFaFgCx14888-00","claim_type":"conservation_status","claim_value":{"text": "Listed as Least Concern on IUCN Red List. While globally secure, many populations are fragmented and degraded by habitat conversion. Primeval forests are now rare. Threatened locally by Acute Oak Decline, Oak Processionary Moth, and powdery mildew. 80% mortality reported in some UK AOD-affected areas.", "threats": ["Acute Oak Decline", "Oak Processionary Moth", "Powdery mildew", "Habitat fragmentation", "Climate change"], "iucn_status": "Least Concern"},"confidence":0.9,"sources":[{"url": "https://www.iucnredlist.org/species/63532/3126467", "type": "database", "title": "IUCN Red List", "credibility": 0.98, "accessed_date": "2026-01-06"}, {"url": "https://www.forestresearch.gov.uk/tools-and-resources/fthr/pest-and-disease-resources/acute-oak-decline/", "type": "government", "title": "Forest Research - AOD", "credibility": 0.95, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"9f50558f-d84b-4996-b499-725440db7aa3","taxon_id":"AngMaFaFgCx14888-00","claim_type":"conservation_status","claim_value":{"full_name": "Least Concern", "iucn_status": "LC", "year_assessed": 2017},"confidence":0.87,"sources":[{"doi": "10.2305/IUCN.UK.2018-1.RLTS.T194843A167525622.en", "url": "https://www.iucnredlist.org/species/194843/167525622", "type": "database", "title": "IUCN Red List", "credibility": 0.98}],"model_version":"claude-opus-4-5-cli","agent_type":"ecological","created_at":"2026-01-06T02:30:59.174803-05:00"}, {"id":"b96b0e18-61cc-4b8f-9882-0245f19a6ed6","taxon_id":"AngMaFaFgCx14888-00","claim_type":"cultural_significance","claim_value":{"text": "National emblem of England. Sacred to Zeus (Greece), Jupiter (Rome), Thor (Norse), and Celtic druids. Royal Oak commemorates Charles II hiding in Boscobel Oak (1651). Oak Apple Day (May 29) still celebrated. \"Royal Oak\" is third most common pub name in Britain. Featured on coins, coats of arms, National Trust emblem. Robin Hood legend at Major Oak.", "folklore": ["Royal Oak (Charles II)", "Major Oak (Robin Hood)", "Oak Apple Day"], "mythology": ["Sacred to thunder gods (Zeus, Jupiter, Thor)", "Celtic druidic rituals", "World tree in Baltic/Slavic mythology"], "national_symbols": ["National emblem of England", "Royal Navy \"Wooden Walls\"", "National Trust emblem", "Pound coin design"]},"confidence":0.93,"sources":[{"url": "https://www.kew.org/plants/oak-tree", "type": "organization", "title": "Kew Gardens", "credibility": 0.95, "accessed_date": "2026-01-06"}, {"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}, {"url": "https://www.shopdixi.com/blogs/news/oak-mythology", "type": "website", "title": "Oak in Tudor Traditions", "credibility": 0.7, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"9334348e-239f-46bd-87d8-d882b03584af","taxon_id":"AngMaFaFgCx14888-00","claim_type":"deciduous_evergreen","claim_value":{"text": "Deciduous. Leaves turn yellow-brown in autumn and fall. Marcescent in young trees - dead leaves may persist through winter before falling.", "type": "Deciduous"},"confidence":0.8,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"ed956283-a19a-4c5b-874f-a604cd00e5ac","taxon_id":"AngMaFaFgCx14888-00","claim_type":"disease_pest_management","claim_value":{"text": "Major threats: Acute Oak Decline (AOD) - bacterial infection with Agrilus beetle, can kill in 4-6 years, 80% mortality in some UK areas. Oak Processionary Moth (OPM) - defoliating caterpillars with irritating hairs. Powdery mildew (Erysiphe alphitoides) - foliar fungal disease, largely cosmetic. Monitor for stem lesions and bleeding (AOD symptoms).", "management": ["Regular monitoring", "Report AOD to authorities", "Avoid transporting oak material", "Maintain tree vigor"], "major_pests": ["Oak Processionary Moth", "Agrilus biguttatus (beetle)", "Gall wasps"], "major_diseases": ["Acute Oak Decline (bacterial)", "Chronic Oak Decline", "Powdery mildew"]},"confidence":0.9,"sources":[{"url": "https://www.forestresearch.gov.uk/tools-and-resources/fthr/pest-and-disease-resources/acute-oak-decline/", "type": "government", "title": "Forest Research - AOD", "credibility": 0.95, "accessed_date": "2026-01-06"}, {"url": "https://www.rhs.org.uk/disease/oak-decline", "type": "organization", "title": "RHS Oak Decline", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"0fb2335b-d01a-4778-a9a9-8954b98ccd31","taxon_id":"AngMaFaFgCx14888-00","claim_type":"ecological_function","claim_value":{"text": "Keystone species supporting over 2,300 associated species in the UK. Provides critical habitat for insects (400+ herbivore species), birds, mammals, fungi, bryophytes, and lichens. Acorns are vital food source for squirrels, jays, deer, and wild boar. Old hollow trees provide roosting sites for bats and nesting sites for owls. Foundation species with disproportionate importance for biodiversity and ecosystem function.", "ecosystem_services": ["Carbon sequestration", "Air purification", "Water purification", "Soil stabilization", "Biodiversity support", "Wildlife habitat", "Food source (acorns)"], "associated_species_count": 2300},"confidence":0.9,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}, {"url": "https://www.sciencedirect.com/science/article/abs/pii/S0378112718321091", "type": "paper", "title": "Integrative management of oak forests", "credibility": 0.93, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"c1377405-d49f-480d-9b77-d99dc74830ab","taxon_id":"AngMaFaFgCx14888-00","claim_type":"elevation_ranges","claim_value":{"text": "Primarily a lowland species, found from sea level to approximately 800m in favorable conditions. Most common below 400m elevation. Prefers valleys and lowlands rather than high elevation terrain.", "unit": "meters", "value": {"max": 800, "min": 0, "typical_max": 400}},"confidence":0.84,"sources":[{"url": "https://www.euforgen.org/species/quercus-robur", "type": "database", "title": "EUFORGEN", "credibility": 0.92, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"3c0c5d19-1516-47be-a5a9-0b513df29ec3","taxon_id":"AngMaFaFgCx14888-00","claim_type":"etymology","claim_value":{"text": "The genus name Quercus is the Latin name for oak trees. The species epithet robur is Latin meaning \"robust\" or \"strong\", referencing the strength and hardwood of this tree. Robur is an ancient Latin term for strong, hard wood, especially oak. Named by Carl Linnaeus in Species Plantarum (1753).", "genus_origin": "Latin quercus = oak tree", "species_origin": "Latin robur = robust, strong, hardwood"},"confidence":0.89,"sources":[{"url": "https://trees.stanford.edu/ENCYC/QUErob.htm", "type": "database", "title": "Trees of Stanford - Quercus robur", "credibility": 0.88, "accessed_date": "2026-01-06"}, {"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Quercus robur - Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"identity","created_at":"2026-01-06T02:59:48.373666-05:00"}, {"id":"fe91d2ab-7a9b-4078-93cd-2c1b2c3846b1","taxon_id":"AngMaFaFgCx14888-00","claim_type":"fire_management","claim_value":{"text": "Mature oaks have moderate fire resistance due to thick bark, but young trees are vulnerable. Historically, prescribed burning was not common in European oak management. Remove accumulated debris from around veteran trees. Oaks can resprout from base after fire damage.", "fire_resistance": "Moderate (mature trees)", "response_to_fire": "Can resprout from base", "management_considerations": "Clear debris around veteran trees"},"confidence":0.84,"sources":[{"url": "https://www.sciencedirect.com/science/article/abs/pii/S0378112718321091", "type": "paper", "title": "Oak forest management study", "credibility": 0.93, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"4abe2919-5988-4ff4-8b76-024a174c1391","taxon_id":"AngMaFaFgCx14888-00","claim_type":"flower_color","claim_value":{"text": "Monoecious with separate male and female flowers on same tree. Male flowers in yellowish-green pendulous catkins 2-4cm long. Female flowers tiny, inconspicuous, reddish-green. Flowers appear in April-May with or just after leaf emergence.", "male_flowers": "Yellow-green catkins", "female_flowers": "Inconspicuous, reddish-green", "flowering_period": "April-May"},"confidence":0.83,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"5267ec70-704f-47b9-bcac-3c79a58e19f8","taxon_id":"AngMaFaFgCx14888-00","claim_type":"fruit_type","claim_value":{"size": "2-2.5cm long", "text": "Acorns (nuts) borne on long stalks (peduncles) 2-8cm - distinguishing feature from sessile oak. Acorns 2-2.5cm long, ovoid, ripening from green to brown in first autumn. Cup (cupule) covers about 1/4 of acorn with overlapping scales. Acorns mature in one growing season. Mast years (heavy production) occur irregularly.", "fruit": "Acorn (nut)", "stalk_length": "2-8cm (pedunculate)"},"confidence":0.83,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"61a2789b-1ced-430b-a572-7c401890e9f5","taxon_id":"AngMaFaFgCx14888-00","claim_type":"general_description","claim_value":{"text": "Quercus robur is a large, long-lived deciduous tree native to most of Europe west of the Caucasus. It is a keystone species in temperate broadleaf forests, supporting over 2,300 associated species in the UK alone. The tree is characterized by its broad spreading crown, deeply fissured bark, and iconic lobed leaves. It produces acorns on distinctive long stalks (peduncles) and can live for over 1,000 years.", "summary": "Large deciduous keystone species of European temperate forests"},"confidence":0.89,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Quercus robur - Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}, {"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"b3aec048-7ed3-44ce-9cf2-b6c110a6f0a4","taxon_id":"AngMaFaFgCx14888-00","claim_type":"general_description","claim_value":{"text": "A large, long-lived deciduous tree native to Europe, recognized for its broad, spreading crown and deeply lobed leaves."},"confidence":0.85,"sources":[{"url": "https://www.iucnredlist.org/species/194843/167525622", "type": "database", "title": "IUCN Red List - Quercus robur", "credibility": 0.95}],"model_version":"claude-opus-4-5-cli","agent_type":"ecological","created_at":"2026-01-06T02:30:59.174803-05:00"}, {"id":"0f44ef0a-5cf5-411e-8eaa-8974dde8df24","taxon_id":"AngMaFaFgCx14888-00","claim_type":"growth_form","claim_value":{"form": "Tree", "text": "Large deciduous tree with broad, spreading, irregularly shaped crown. Single trunk that often becomes gnarled and hollow with age. Branches often twisted and spreading, especially in open-grown specimens. Deep taproot when young, developing extensive lateral root system at maturity.", "crown_shape": "Broad, spreading, irregular"},"confidence":0.83,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"adba5b29-a2ca-4208-8613-723c3797b588","taxon_id":"AngMaFaFgCx14888-00","claim_type":"habitat","claim_value":{"text": "Temperate broadleaf and mixed forests on clay-rich, well-drained soils"},"confidence":0.8,"sources":[{"url": "https://www.worldagroforestry.org/treedb/", "type": "database", "title": "World Agroforestry", "credibility": 0.85}],"model_version":"claude-opus-4-5-cli","agent_type":"ecological","created_at":"2026-01-06T02:30:59.174803-05:00"}, {"id":"d6569156-0656-4b2e-80d1-1f4218284cc4","taxon_id":"AngMaFaFgCx14888-00","claim_type":"habitat","claim_value":{"text": "Found in deciduous and mixed woodlands, often forming dominant stands. Typical of valleys of large European rivers and damp lowlands. Pioneer species in plains and hills, late successional in valleys and floodplains. Common in lowland forests, wood pastures, coppice, and hedgerows. Tolerates intermittent flooding near swamps, rivers and ponds.", "soil_moisture": "Mesic to moist, tolerates seasonal flooding", "primary_habitats": ["Lowland deciduous forest", "Mixed woodland", "River valleys", "Floodplains", "Wood pasture", "Coppice woodland"]},"confidence":0.9,"sources":[{"url": "https://www.euforgen.org/species/quercus-robur", "type": "database", "title": "EUFORGEN - Quercus robur", "credibility": 0.92, "accessed_date": "2026-01-06"}, {"url": "https://forest.jrc.ec.europa.eu/media/atlas/Quercus_robur_petraea.pdf", "type": "research", "title": "JRC Forest Atlas", "credibility": 0.93, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"5b1630bf-3984-497f-917c-f96c78da009c","taxon_id":"AngMaFaFgCx14888-00","claim_type":"identification_features","claim_value":{"text": "Distinguished by obovate leaves 10-12cm long with 4-5 rounded lobes on each side, very short petiole (2-7mm), distinctive auricles at leaf base. Acorns on long peduncles (2-8cm) - hence \"pedunculate oak\". Bark gray-brown with deep vertical fissures in mature trees. Crown broad and spreading with often twisted branches.", "key_features": {"bark": "Gray-brown, deeply fissured vertical ridges, rugged and corky with age", "form": "Broad spreading crown, often twisted branches, can become gnarled and hollow with age", "acorns": "On long stalks (peduncles) 2-8cm, cup covers 1/4 of acorn, 2-2.5cm long", "leaves": "Obovate, 10-12cm, 4-5 rounded lobes, short petiole, auricles at base"}},"confidence":0.9,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust - English Oak", "credibility": 0.9, "accessed_date": "2026-01-06"}, {"url": "https://gobotany.nativeplanttrust.org/species/quercus/robur/", "type": "database", "title": "Go Botany - Quercus robur", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"identity","created_at":"2026-01-06T02:59:48.373666-05:00"}, {"id":"fc7e42df-5e99-4371-8499-7a6067d01447","taxon_id":"AngMaFaFgCx14888-00","claim_type":"leaf_type","claim_value":{"text": "Simple, obovate leaves with 4-5 pairs of rounded lobes. 10-12cm long. Dark green above, paler blue-green beneath. Very short petiole (2-7mm). Distinctive auricles (ear-like projections) at leaf base. Sinuses extend about halfway to midrib. Leaves clustered at branch tips.", "leaf_shape": "Obovate, lobed", "leaf_margin": "Deeply lobed (4-5 pairs)", "leaf_arrangement": "Alternate"},"confidence":0.82,"sources":[{"url": "https://gobotany.nativeplanttrust.org/species/quercus/robur/", "type": "database", "title": "Go Botany", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"1f7f3d16-ff37-4e6e-a693-1000e476103b","taxon_id":"AngMaFaFgCx14888-00","claim_type":"lifespan","claim_value":{"text": "Extremely long-lived species. Average lifespan 300-500 years. Can live 500-1000+ years in exceptional cases. Natural lifespan between 300-900 years in European oak woodlands. Some ancient specimens estimated over 1,000 years old.", "average_years": {"max": 500, "min": 300}, "maximum_years": 1000},"confidence":0.84,"sources":[{"url": "https://www.sciencedirect.com/science/article/abs/pii/S0378112718321091", "type": "paper", "title": "Oak forest biodiversity study", "credibility": 0.93, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"e6e4898b-d6e4-48a5-a008-691fe3353aee","taxon_id":"AngMaFaFgCx14888-00","claim_type":"maximum_diameter","claim_value":{"text": "Mature trees commonly have trunk diameters of 1-2 meters. Ancient specimens can exceed 3-4 meters in diameter. Some of the oldest oaks in Europe have massive, hollow trunks.", "unit": "meters", "value": 4, "typical_range": {"max": 2, "min": 1}},"confidence":0.8,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"514f949b-65b2-4027-bf37-5184b137fc0e","taxon_id":"AngMaFaFgCx14888-00","claim_type":"maximum_height","claim_value":{"unit": "meters", "value": 40},"confidence":0.8,"sources":[{"url": "https://www.conifers.org/cu/Quercus_robur.php", "type": "database", "title": "Gymnosperm Database", "credibility": 0.85}],"model_version":"claude-opus-4-5-cli","agent_type":"morphological","created_at":"2026-01-06T02:30:59.161476-05:00"}, {"id":"0dc99297-04ba-4f0f-8cdf-763df171aad4","taxon_id":"AngMaFaFgCx14888-00","claim_type":"maximum_height","claim_value":{"text": "Typically grows 20-40 meters tall. Maximum height can reach 40-45 meters in optimal conditions. Open-grown trees tend to be shorter and broader than forest-grown specimens.", "unit": "meters", "value": 40, "typical_range": {"max": 40, "min": 20}},"confidence":0.9,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}, {"url": "https://www.missouribotanicalgarden.org/PlantFinder/PlantFinderDetails.aspx?taxonid=280706", "type": "database", "title": "Missouri Botanical Garden", "credibility": 0.92, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"29c6a9fa-9820-4452-a5b9-23333dec934c","taxon_id":"AngMaFaFgCx14888-00","claim_type":"maximum_tree_age","claim_value":{"text": "Some ancient oaks in Europe are estimated to be over 1,000-1,500 years old. The Bowthorpe Oak in Lincolnshire, England is estimated at 1,000+ years. Very durable wood even in decay stage contributes to longevity.", "unit": "years", "value": 1500, "notable_specimens": ["Bowthorpe Oak (England, ~1000 years)", "Major Oak (Sherwood Forest)", "Kongeegen (Denmark)"]},"confidence":0.8,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"morphological","created_at":"2026-01-06T02:59:48.350749-05:00"}, {"id":"3b7aedbb-fd69-4849-bae5-1aca598c36e1","taxon_id":"AngMaFaFgCx14888-00","claim_type":"native_adapted_habitats","claim_value":{"text": "Native to most of Europe and western Asia. Distribution includes all European countries from Ireland to the Caucasus, extending into Iran and Turkey. More typical of valleys and damp lowlands than sessile oak (Q. petraea). Adapted to temperate climate with warm summers and cool winters.", "countries": ["Albania", "Austria", "Belarus", "Belgium", "Bulgaria", "Czech Republic", "Denmark", "Finland", "France", "Germany", "Great Britain", "Greece", "Hungary", "Iran", "Ireland", "Italy", "Netherlands", "Norway", "Poland", "Portugal", "Romania", "Russia", "Spain", "Sweden", "Switzerland", "Turkey", "Ukraine"], "native_regions": ["Europe", "Western Asia", "Caucasus", "Iran"]},"confidence":0.85,"sources":[{"url": "https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:304293-2", "type": "database", "title": "Kew Plants of the World Online", "credibility": 0.95, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}, {"id":"cad46c79-a454-4fdb-a0c6-14acac921833","taxon_id":"AngMaFaFgCx14888-00","claim_type":"non_timber_products","claim_value":{"text": "Tannins from bark for leather industry. Acorns historically used for pig fodder (pannage). Gall wasp galls produced oak gall ink. Cork (though primarily from Q. suber). Medicinal uses of bark (astringent). Dye from bark. Truffles associated with oak roots.", "products": ["Tannins (leather)", "Acorns (fodder)", "Oak gall ink", "Bark (medicine/dye)", "Truffles (mycorrhizal)"], "historical_uses": ["Ink production", "Tanning", "Traditional medicine"]},"confidence":0.9,"sources":[{"url": "https://link.springer.com/article/10.1007/s10457-021-00718-3", "type": "paper", "title": "Oak provisioning services", "credibility": 0.93, "accessed_date": "2026-01-06"}, {"url": "https://pfaf.org/user/Plant.aspx?LatinName=Quercus+robur", "type": "database", "title": "PFAF Database", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"e960602e-e407-45c5-afce-4c8b4fb1369e","taxon_id":"AngMaFaFgCx14888-00","claim_type":"nutritional_caloric_value","claim_value":{"text": "Acorns edible after leaching tannins. High in carbohydrates and fats. Historically important food source (acorn bread/flour) during famines. Raw acorns contain tannins that are toxic to humans but can be leached out. Acorns consumed by wildlife (deer, squirrels, jays, wild boar).", "edibility": "Edible after processing (leaching tannins)", "nutrients": ["Carbohydrates", "Fats", "Some protein"], "wildlife_value": "Critical food source for many species", "processing_required": "Leaching to remove tannins"},"confidence":0.82,"sources":[{"url": "https://pfaf.org/user/Plant.aspx?LatinName=Quercus+robur", "type": "database", "title": "PFAF Database", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"8689e7d8-e7ea-4452-8dfc-a89cb6255bbf","taxon_id":"AngMaFaFgCx14888-00","claim_type":"planting_recipes","claim_value":{"text": "Best planted as acorns in autumn (October-November) or bare-root transplants in dormant season (November-March). Sow acorns 5cm deep in deep pots or direct in ground with rodent protection. Germination in 4-6 weeks. Transplant seedlings at 2-3 years old. Avoid disturbing taproot.", "methods": ["Direct acorn sowing", "Container-grown", "Bare-root transplants"], "best_time": "Autumn (acorns) or dormant season (transplants)", "soil_prep": "Deep cultivation, good drainage, no waterlogging"},"confidence":0.86,"sources":[{"url": "https://treegrowing.tcv.org.uk/grow/tree-recipes/pedunculateoak", "type": "organization", "title": "TCV Tree Growing Guide", "credibility": 0.88, "accessed_date": "2026-01-06"}, {"url": "https://homeguides.sfgate.com/plant-english-oak-acorn-66874.html", "type": "website", "title": "SF Gate Home Guides", "credibility": 0.75, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"9b347de8-3d79-4500-bbdc-8dbfbf584276","taxon_id":"AngMaFaFgCx14888-00","claim_type":"popular_common_name","claim_value":{"text": "English Oak", "alternatives": ["Pedunculate Oak", "Common Oak"]},"confidence":0.83,"sources":[{"url": "https://www.rhs.org.uk/plants/14066/quercus-robur/details", "type": "database", "title": "RHS - Quercus robur", "credibility": 0.9}],"model_version":"claude-opus-4-5-cli","agent_type":"identity","created_at":"2026-01-06T02:30:59.181545-05:00"}, {"id":"dbf17c67-d050-4a21-9603-fe178b2f870c","taxon_id":"AngMaFaFgCx14888-00","claim_type":"popular_common_name","claim_value":{"primary": "English Oak", "alternatives": ["Pedunculate Oak", "Common Oak", "European Oak", "French Oak", "Polish Oak", "Truffle Oak"], "regional_names": {"Italy": "róvere", "Spain": "roble", "France": "chêne pédonculé", "Scotland": "aik", "West England": "woke/woak", "South England": "yak"}},"confidence":0.93,"sources":[{"url": "https://en.wikipedia.org/wiki/Quercus_robur", "type": "encyclopedia", "title": "Quercus robur - Wikipedia", "credibility": 0.85, "accessed_date": "2026-01-06"}, {"url": "https://plants.ces.ncsu.edu/plants/quercus-robur/", "type": "database", "title": "NC State Extension Gardener Plant Toolbox", "credibility": 0.9, "accessed_date": "2026-01-06"}, {"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust - English Oak", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"identity","created_at":"2026-01-06T02:59:48.373666-05:00"}, {"id":"1e067631-a457-426b-83ab-4df1c1932406","taxon_id":"AngMaFaFgCx14888-00","claim_type":"propagation_methods","claim_value":{"text": "Primarily propagated from seed (acorns). Collect in autumn when brown; float test for viability. Q. robur does not require stratification - can be sown immediately. Plant 5cm deep. Germination in 4-6 weeks. Can also be grafted for cultivar propagation. Cuttings difficult to root.", "methods": ["Seed (acorns)", "Grafting (cultivars)"], "success_rate": "High from fresh, viable acorns", "seed_treatment": "No stratification required - sow fresh", "germination_time": "4-6 weeks"},"confidence":0.89,"sources":[{"url": "https://treegrowing.tcv.org.uk/grow/tree-recipes/pedunculateoak", "type": "organization", "title": "TCV Tree Growing", "credibility": 0.88, "accessed_date": "2026-01-06"}, {"url": "https://www.extension.iastate.edu/news/yard-and-garden-handling-germinating-and-planting-acorns", "type": "database", "title": "Iowa State Extension", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"8f8b0639-861e-438d-8277-e4b88bb3cbab","taxon_id":"AngMaFaFgCx14888-00","claim_type":"pruning_maintenance","claim_value":{"text": "Minimal pruning required. If needed, prune in late winter/early spring (February-March) when dormant. Remove dead, diseased, or crossing branches. Formative pruning for young trees to establish strong structure. Avoid heavy pruning of mature trees. Never remove more than 25% of crown.", "cautions": ["Avoid summer pruning (disease entry)", "Preserve lower branches on young trees", "Consult arborist for mature trees"], "best_time": "Late winter to early spring (dormant)", "frequency": "Minimal - as needed"},"confidence":0.83,"sources":[{"url": "https://www.rhs.org.uk/disease/oak-decline", "type": "organization", "title": "RHS Oak Decline", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"63d4a8a7-8508-4f8b-a033-9429143ba181","taxon_id":"AngMaFaFgCx14888-00","claim_type":"stewardship_best_practices","claim_value":{"text": "Plant in full sun to partial shade in deep, fertile soil. Provide adequate space (15-20m crown spread at maturity). Protect from livestock when young. Monitor for Acute Oak Decline and Oak Processionary Moth. Maintain deadwood habitat for biodiversity. Avoid soil compaction around root zone.", "planting_distance": "15-20m minimum", "key_considerations": ["Deep planting hole", "Stake for first 2-3 years", "Protect from browsing", "Monitor for pests/diseases", "Preserve veteran trees"]},"confidence":0.83,"sources":[{"url": "https://www.woodlandtrust.org.uk/trees-woods-and-wildlife/british-trees/a-z-of-british-trees/english-oak/", "type": "organization", "title": "Woodland Trust", "credibility": 0.9, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"cbf14efa-73e2-42bf-8f2a-da671a60b131","taxon_id":"AngMaFaFgCx14888-00","claim_type":"synonyms","claim_value":{"text": "Quercus robur is the type species of the genus Quercus and is classified in the white oak section (Quercus section Quercus). Trade names for the timber include French Oak, Polish Oak, Slavonian Oak, depending on geographic origin.", "trade_names": ["French Oak", "Polish Oak", "Slavonian Oak", "European Oak"], "taxonomic_synonyms": []},"confidence":0.85,"sources":[{"url": "https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:304293-2", "type": "database", "title": "Plants of the World Online - Kew", "credibility": 0.95, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"identity","created_at":"2026-01-06T02:59:48.373666-05:00"}, {"id":"8d712ccc-72cc-424a-9645-65aa07ba466c","taxon_id":"AngMaFaFgCx14888-00","claim_type":"timber_value","claim_value":{"text": "Highly valued hardwood. Density ~720 kg/m3. Extremely durable heartwood prized for furniture, construction, shipbuilding, flooring, timber frames, barrels (cooperage). Takes 150+ years to mature for construction timber. One of the best building materials. Premium prices for quality logs.", "uses": ["Furniture", "Construction/timber frames", "Shipbuilding (historical)", "Cooperage (barrels)", "Flooring", "Veneers", "Exterior cladding"], "wood_properties": {"density": "720 kg/m3", "durability": "Very high", "workability": "Good"}, "commercial_value": "Premium hardwood, high value"},"confidence":0.88,"sources":[{"url": "https://www.wlwest.co.uk/news/the-best-uses-and-properties-of-oak-wood", "type": "website", "title": "W.L West - Oak Properties", "credibility": 0.82, "accessed_date": "2026-01-06"}, {"url": "https://www.ucc.ie/en/tree-explorers/trees/a-z/quercusrobur/", "type": "database", "title": "UCC Tree Explorers", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"stewardship","created_at":"2026-01-06T02:59:48.381401-05:00"}, {"id":"16cf94ba-13bc-49f5-985a-8ba2e8fb3bde","taxon_id":"AngMaFaFgCx14888-00","claim_type":"tolerances","claim_value":{"text": "Tolerates waterlogging and flooding for up to 3 months. Once established, moderately drought tolerant on deep soils. Wind tolerant. Pollution tolerant, suitable for urban environments. Salt tolerance low. Tolerates lime/alkaline conditions.", "salt_tolerance": "Low", "flood_tolerance": "High - up to 3 months", "drought_tolerance": "Moderate when established", "pollution_tolerance": "Good"},"confidence":0.82,"sources":[{"url": "https://pfaf.org/user/Plant.aspx?LatinName=Quercus+robur", "type": "database", "title": "PFAF Database", "credibility": 0.88, "accessed_date": "2026-01-06"}],"model_version":"claude-code-cli","agent_type":"ecological","created_at":"2026-01-06T02:59:48.364147-05:00"}]
