# =============================================================================
# TreeKipedia Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Application Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-this-in-production

# Server Configuration
PORT=5001
HOST=0.0.0.0
WORKERS=4

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=treekipedia
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Apache Fuseki (Triple Store)
FUSEKI_HOST=localhost
FUSEKI_PORT=3030
FUSEKI_DATASET=treekipedia
FUSEKI_ENABLED=True
FUSEKI_USERNAME=your_fuseki_username
FUSEKI_PASSWORD=your_fuseki_password

# Google Sheets Integration
GOOGLE_SHEETS_ENABLED=True
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Occurrence Data System
OCCURRENCE_STORAGE_PATH=data/occurrences
OCCURRENCE_S3_BUCKET=
MAX_UPLOAD_SIZE_MB=2048

# AWS S3 (Optional - for occurrence data cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Security
ALLOWED_ORIGINS=http://localhost:5001,https://yourdomain.com
RATE_LIMIT_ENABLED=True
