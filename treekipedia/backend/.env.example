# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/treekipedia

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
DEBUG_CORS=true

# Blockchain Configuration
BASE_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_INFURA_API_KEY
INFURA_API_KEY=your_infura_api_key_here

# Wallet Configuration (for backend operations)
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# AI Research APIs
OPENAI_API_KEY=your_openai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# IPFS Configuration (Lighthouse)
LIGHTHOUSE_API_KEY=your_lighthouse_api_key_here

# EAS (Ethereum Attestation Service) Configuration
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021
SCHEMA_UID=your_eas_schema_uid_here

# Smart Contract Addresses
PAYMENT_CONTRACT_ADDRESS=your_payment_contract_address
NFT_CONTRACT_ADDRESS=your_nft_contract_address

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
