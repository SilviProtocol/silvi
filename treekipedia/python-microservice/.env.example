# Treekipedia Python Microservice Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Service Configuration
# =============================================================================
PORT=5002
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
POSTGRES_HOST=167.172.143.162
POSTGRES_DB=treekipedia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_PORT=5432

# =============================================================================
# Apache Fuseki Triple Store Configuration
# =============================================================================
FUSEKI_BASE_URL=http://167.172.143.162:3030
FUSEKI_DATASET=treekipedia
FUSEKI_SPARQL_ENDPOINT=http://167.172.143.162:3030/treekipedia/sparql
FUSEKI_UPDATE_ENDPOINT=http://167.172.143.162:3030/treekipedia/update
FUSEKI_DATA_ENDPOINT=http://167.172.143.162:3030/treekipedia/data

# =============================================================================
# Google Sheets Integration (Optional)
# =============================================================================
# Set to true if using Google Sheets integration
USE_GOOGLE_SHEETS=false

# Path to Google Service Account credentials JSON file
# Get this from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-credentials.json

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable specific data sources
POSTGRESQL_ENABLED=true
BLAZEGRAPH_ENABLED=false

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/treekipedia-python-microservice.log

# =============================================================================
# Performance Tuning
# =============================================================================
# Default batch size for PostgreSQL → Fuseki sync
DEFAULT_BATCH_SIZE=1000

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=32

# =============================================================================
# Internal Security
# =============================================================================
# Shared secret for Express backend authentication (optional)
INTERNAL_AUTH_TOKEN=change-this-to-random-string-in-production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:3000
